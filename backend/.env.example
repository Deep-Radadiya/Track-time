# Postgres
DATABASE_URL=postgresql+asyncpg://reminder:reminder@localhost:5432/reminder_db
TEST_DATABASE_URL=postgresql+asyncpg://reminder:reminder@localhost:5432/reminder_test_db

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# LLM providers
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your-openai-api-key-here
VOICE_MODEL=gpt-4o-mini

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIMS_SUB=mailto:you@example.com

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Misc
GRACE_PERIOD_MINUTES=5
ENVIRONMENT=development

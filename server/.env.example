# MongoDB connection string (from MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/track_time

# Long random text used to sign login tokens
JWT_SECRET_KEY=change-me

# Website addresses allowed to call this server (comma separated)
CORS_ORIGINS=http://localhost:5173

PORT=8000

# Web Push keys (the frontend needs the same public key)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:you@example.com

# AI daily summary (optional, from console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
